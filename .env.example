# Space-separated list of configs in /config/ to build and deploy (e.g. "mebbr suckless")
DEPLOY_SITES="mebbr suckless"

# Default SSH settings
SSH_KEY_PATH="~/.ssh/id_ed25519"
SSH_PORT="22"

# Per-site rsync targets (format: user@host:/path/to/wp-content/themes/theme-folder/)
# Variable name must match DEPLOY_TARGET_<config_name>
DEPLOY_TARGET_mebbr="deploy@example.com:/var/www/mebbr.ru/wp-content/themes/mebbr/"
DEPLOY_TARGET_suckless="deploy@example.com:/var/www/suckless.ru/wp-content/themes/mebbr/"
